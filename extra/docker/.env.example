# Copy to .env and adjust. Compose reads it automatically.

# Server image tag: nightly (rolling master build), a version like 0.22.0, latest, or sha-<7 chars>
MANGOS_TAG=nightly

# Database
DB_ROOT_PASSWORD=mangos
DB_USER=mangos
DB_PASSWORD=mangos

# Host ports
DB_PORT=3306
REALMD_PORT=3724
MANGOSD_PORT=8085
