include("${CMAKE_CURRENT_LIST_DIR}/GateGuards.cmake")
gate_require_source_root("Database call gate")

set(DB_CALL_RE "(^|[^A-Za-z0-9_])(CharacterDatabase|WorldDatabase|LoginDatabase)[ \t]*\\.[ \t]*[A-Za-z_][A-Za-z0-9_]*[ \t]*\\(")

function(db_call_in_line line out)
    set(code "${line}")
    string(FIND "${code}" "//" comment_at)
    if(NOT comment_at EQUAL -1)
        string(SUBSTRING "${code}" 0 ${comment_at} code)
    endif()
    string(STRIP "${code}" code)
    if(code MATCHES "^(\\*|/\\*)")
        set(code "")
    endif()
    if(code MATCHES "${DB_CALL_RE}")
        set(${out} ON PARENT_SCOPE)
    else()
        set(${out} OFF PARENT_SCOPE)
    endif()
endfunction()

function(assert_db_call label text expected)
    db_call_in_line("${text}" got)
    if(NOT got STREQUAL expected)
        message(FATAL_ERROR "Database call gate self-test failed: ${label} (got ${got}, want ${expected})")
    endif()
endfunction()

assert_db_call("a query" "QueryResult* result = CharacterDatabase.Query(sql)" ON)
assert_db_call("a queued write" "WorldDatabase.PExecuteLog(\"DELETE FROM `game_tele`\")" ON)
assert_db_call("a transaction" "LoginDatabase.BeginTransaction()" ON)
assert_db_call("whitespace around the dot and the paren" "CharacterDatabase . AsyncPQuery (cb, sql)" ON)
assert_db_call("a call after other code on the line" "if (ok) { CharacterDatabase.CommitTransaction()" ON)
assert_db_call("a database handed as an argument" "sObjectMgr.LoadMangosStrings(WorldDatabase, \"mangos_string\", 1, 2, false)" OFF)
assert_db_call("a database's address" "DbThreadGuard dbThread(&WorldDatabase)" OFF)
assert_db_call("the definition" "DatabaseType WorldDatabase" OFF)
assert_db_call("a longer name" "MyCharacterDatabase.Query(sql)" OFF)
assert_db_call("a line comment" "// CharacterDatabase.PQuery is what this replaced" OFF)
assert_db_call("a doc comment" "/// CharacterDatabase.AsyncPQuery calls it through the singleton" OFF)
assert_db_call("a trailing comment" "Save()   // CharacterDatabase.Execute ran here" OFF)
assert_db_call("a block comment line" " * CharacterDatabase.DirectExecute(sql) blocks" OFF)

set(ROOTS "${SOURCE_ROOT}/src/game" "${SOURCE_ROOT}/src/modules" "${SOURCE_ROOT}/src/shared" "${SOURCE_ROOT}/src/mangosd")
set(SOURCES "")
foreach(ROOT_DIR IN LISTS ROOTS)
    if(NOT IS_DIRECTORY "${ROOT_DIR}")
        message(FATAL_ERROR "Database call gate: missing ${ROOT_DIR}")
    endif()
    file(GLOB_RECURSE FOUND "${ROOT_DIR}/*.cpp" "${ROOT_DIR}/*.h")
    list(APPEND SOURCES ${FOUND})
endforeach()
list(FILTER SOURCES EXCLUDE REGEX "/src/game/persistence/")
list(FILTER SOURCES EXCLUDE REGEX "/src/shared/Database/")
list(LENGTH SOURCES SOURCE_COUNT)
gate_require_scanned("Database call gate" "${SOURCE_COUNT}" "sources outside persistence")
if(SOURCE_COUNT LESS 100)
    message(FATAL_ERROR "Database call gate found only ${SOURCE_COUNT} sources outside persistence -- gate is inert")
endif()

file(GLOB_RECURSE PERSISTENCE_SOURCES "${SOURCE_ROOT}/src/game/persistence/*.cpp")
set(PERSISTENCE_CALLS 0)
foreach(FILE_PATH IN LISTS PERSISTENCE_SOURCES)
    file(STRINGS "${FILE_PATH}" LINES REGEX "${DB_CALL_RE}")
    foreach(LINE IN LISTS LINES)
        db_call_in_line("${LINE}" IS_CALL)
        if(IS_CALL)
            math(EXPR PERSISTENCE_CALLS "${PERSISTENCE_CALLS} + 1")
        endif()
    endforeach()
endforeach()
if(PERSISTENCE_CALLS EQUAL 0)
    message(FATAL_ERROR "Database call gate saw no database call in persistence either -- the pattern is inert")
endif()

set(STRAYS "")
foreach(FILE_PATH IN LISTS SOURCES)
    file(STRINGS "${FILE_PATH}" LINES REGEX "${DB_CALL_RE}")
    foreach(LINE IN LISTS LINES)
        db_call_in_line("${LINE}" IS_CALL)
        if(NOT IS_CALL)
            continue()
        endif()
        string(STRIP "${LINE}" STRIPPED)
        file(RELATIVE_PATH REL "${SOURCE_ROOT}" "${FILE_PATH}")
        list(APPEND STRAYS "${REL}: ${STRIPPED}")
    endforeach()
endforeach()

if(STRAYS)
    string(REPLACE ";" "\n  " PRETTY "${STRAYS}")
    message(FATAL_ERROR
        "A database call outside persistence and the database driver:\n  ${PRETTY}\n\n"
        "A repository under src/game/persistence spells the SQL and calls the database;\n"
        "the game calls the repository.")
endif()
message(STATUS "database calls: ${SOURCE_COUNT} files outside persistence and the database driver call no CharacterDatabase, WorldDatabase or LoginDatabase method; ${PERSISTENCE_CALLS} call lines in persistence, self-test OK")
