include("${CMAKE_CURRENT_LIST_DIR}/GateGuards.cmake")
gate_require_source_root("Row type gate")

set(ROW_TYPE_RE "QueryResult[ \t]*\\*|QueryResult[ \t]*>|class[ \t]+QueryResult[ \t]*;|QueryNamedResult|QueryFieldNames|(^|[^A-Za-z0-9_])Field[ \t]*(const[ \t]*)?\\*|->Fetch[ \t]*\\(")

function(assert_row_type label text expected)
    if(text MATCHES "${ROW_TYPE_RE}")
        set(got ON)
    else()
        set(got OFF)
    endif()
    if(NOT got STREQUAL expected)
        message(FATAL_ERROR "Row type gate self-test failed: ${label} (got ${got}, want ${expected})")
    endif()
endfunction()

assert_row_type("a result pointer" "QueryResult* result = CharacterDatabase.Query(sql);" ON)
assert_row_type("a result owned by a unique_ptr" "std::unique_ptr<QueryResult> result(holder->GetResult(0));" ON)
assert_row_type("a forward declaration" "class QueryResult;" ON)
assert_row_type("a named result" "QueryNamedResult* names = db.PQueryNamed(sql);" ON)
assert_row_type("a field pointer" "Field* fields = result->Fetch();" ON)
assert_row_type("a const field pointer" "const Field* fields = row;" ON)
assert_row_type("a fetch" "uint32 id = result->Fetch()[0].GetUInt32();" ON)
assert_row_type("a row type" "std::vector<CharacterEnumRow> rows = CharacterRepository::QueryEnum();" OFF)
assert_row_type("a field of another name" "UpdateField* update = object->GetField();" OFF)
assert_row_type("a holder" "void HandlePlayerLoginCallback(SqlQueryHolder* holder);" OFF)

set(ROOTS "${SOURCE_ROOT}/src/game" "${SOURCE_ROOT}/src/modules")
set(SOURCES "")
foreach(ROOT_DIR IN LISTS ROOTS)
    if(NOT IS_DIRECTORY "${ROOT_DIR}")
        message(FATAL_ERROR "Row type gate: missing ${ROOT_DIR}")
    endif()
    file(GLOB_RECURSE FOUND "${ROOT_DIR}/*.cpp" "${ROOT_DIR}/*.h")
    list(APPEND SOURCES ${FOUND})
endforeach()
list(FILTER SOURCES EXCLUDE REGEX "/src/game/persistence/")
list(LENGTH SOURCES SOURCE_COUNT)
if(SOURCE_COUNT LESS 100)
    message(FATAL_ERROR "Row type gate found only ${SOURCE_COUNT} sources outside persistence -- gate is inert")
endif()

set(PERSISTENCE_SOURCES "")
file(GLOB_RECURSE PERSISTENCE_SOURCES "${SOURCE_ROOT}/src/game/persistence/*.cpp")
set(PERSISTENCE_READS 0)
foreach(FILE_PATH IN LISTS PERSISTENCE_SOURCES)
    file(STRINGS "${FILE_PATH}" HITS REGEX "${ROW_TYPE_RE}")
    list(LENGTH HITS HIT_COUNT)
    math(EXPR PERSISTENCE_READS "${PERSISTENCE_READS} + ${HIT_COUNT}")
endforeach()
if(PERSISTENCE_READS EQUAL 0)
    message(FATAL_ERROR "Row type gate saw no result read in persistence either -- the pattern is inert")
endif()

set(STRAYS "")
foreach(FILE_PATH IN LISTS SOURCES)
    file(STRINGS "${FILE_PATH}" LINES REGEX "${ROW_TYPE_RE}")
    foreach(LINE IN LISTS LINES)
        string(STRIP "${LINE}" STRIPPED)
        if(STRIPPED MATCHES "^(//|\\*|/\\*)")
            continue()
        endif()
        file(RELATIVE_PATH REL "${SOURCE_ROOT}" "${FILE_PATH}")
        list(APPEND STRAYS "${REL}: ${STRIPPED}")
    endforeach()
endforeach()

if(STRAYS)
    string(REPLACE ";" "\n  " PRETTY "${STRAYS}")
    message(FATAL_ERROR
        "A database row type outside persistence:\n  ${PRETTY}\n\n"
        "A repository under src/game/persistence reads the result and answers rows or values;\n"
        "the code that loads, handles or shows them names the row, never QueryResult or Field.")
endif()
message(STATUS "row types: ${SOURCE_COUNT} files outside persistence name no QueryResult, QueryNamedResult or Field; ${PERSISTENCE_READS} result lines in persistence, self-test OK")
