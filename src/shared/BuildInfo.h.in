#pragma once

// GENERATED from BuildInfo.h.in -- the one template this build has.
//
// Everything CMake knows and the code needs: what this build IS (package,
// version, client), what it was built FROM (the checkout), what it expects to
// find AROUND it (schemas, config files, install paths). It was three separate
// templates -- revision_data.h.in, SystemConfig.h.in and win/VersionInfo.h.in --
// generated from the same variables at the same moment into the same tree,
// which is three places to look for a value and three places for one to be
// missing.
//
// The numbers themselves are NOT declared here. They come from
// cmake/MangosVersions.cmake; a value written into this file directly is one
// that cannot be bumped from the place everything else is bumped.
//
// This header is rewritten whenever any of them changes, so what includes it
// gets rebuilt. Read a VERSION through GitRevision instead -- it includes this
// and exposes the values as functions, which is what keeps a config-version
// bump from rebuilding the server. The paths and defaults below are fair game
// for a .cpp: they change when the install layout does, not when a version does.
// No HEADER may include this; src/tests/CheckVersionSources.cmake enforces both.

// The Windows resource compiler includes this file too, for the version block
// at the bottom. It is not a C++ compiler: it cannot resolve this include path,
// and it has no business parsing the header anyway. RC_INVOKED is what it
// defines to let a header tell the two apart.
#ifndef RC_INVOKED
#include "Platform/Define.h"
#endif

// --- What this build is ------------------------------------------------------

#define MANGOS_PACKAGENAME "@MANGOS_PKG@"

#define MANGOS_VERSION(REVD, REVT, REVN, REVH) \
    "@PROJECT_VERSION@" " (" REVD " " REVT " Revision " REVN " - " REVH ")"

// --- What it was built from --------------------------------------------------

#define REVISION_HASH     "@rev_hash@"
#define REVISION_DATE     "@rev_date@"
#define REVISION_BRANCH   "@rev_branch@"

#define CMAKE_VERSION     R"(@CMAKE_VERSION@)"
#define CMAKE_HOST_SYSTEM R"(@CMAKE_HOST_SYSTEM_NAME@ @CMAKE_HOST_SYSTEM_VERSION@)"

#define PROJECT_REVISION_NR "@MANGOS_REVISION_NR@"

// --- Configuration files it expects ------------------------------------------
//
// Format YYYYMMDDRR. Compared against the ConfVersion in the .conf actually
// loaded; the same values are substituted into the .conf.dist templates, so the
// two sides cannot disagree.

#define MANGOSD_CONFIG_VERSION @MANGOS_WORLD_VER@
#define REALMD_CONFIG_VERSION  @MANGOS_REALM_VER@
#define AHBOT_CONFIG_VERSION   @MANGOS_AHBOT_VER@

// --- The client it speaks ----------------------------------------------------
//
// One build, deliberately: two would mean half the features work for one set of
// players and half for the other, with neither half testable. The trailing zero
// terminates the list GitRevision walks.

#define EXPECTED_MANGOSD_CLIENT_BUILD   {@MANGOS_CLIENT_BUILD@, 0}
#define EXPECTED_MANGOSD_CLIENT_VERSION "@MANGOS_CLIENT_VERSION@"

// --- Database schemas it requires --------------------------------------------

#define REALMD_DB_VERSION_NR      "@MANGOS_REALMD_DB_VERSION@"
#define REALMD_DB_STRUCTURE_NR    "@MANGOS_REALMD_DB_STRUCTURE@"
#define REALMD_DB_CONTENT_NR      "@MANGOS_REALMD_DB_CONTENT@"
#define REALMD_DB_UPDATE_DESCRIPT "@MANGOS_REALMD_DB_DESCRIPT@"

#define CHAR_DB_VERSION_NR        "@MANGOS_CHAR_DB_VERSION@"
#define CHAR_DB_STRUCTURE_NR      "@MANGOS_CHAR_DB_STRUCTURE@"
#define CHAR_DB_CONTENT_NR        "@MANGOS_CHAR_DB_CONTENT@"
#define CHAR_DB_UPDATE_DESCRIPT   "@MANGOS_CHAR_DB_DESCRIPT@"

#define WORLD_DB_VERSION_NR       "@MANGOS_WORLD_DB_VERSION@"
#define WORLD_DB_STRUCTURE_NR     "@MANGOS_WORLD_DB_STRUCTURE@"
#define WORLD_DB_CONTENT_NR       "@MANGOS_WORLD_DB_CONTENT@"
#define WORLD_DB_UPDATE_DESCRIPT  "@MANGOS_WORLD_DB_DESCRIPT@"

// --- Where it installs itself ------------------------------------------------

#define SYSCONFDIR "@CONF_INSTALL_DIR@/"

#define REALMD_CONFIG_NAME          "realmd.conf"
#define MANGOSD_CONFIG_NAME         "mangosd.conf"
#define AUCTIONHOUSEBOT_CONFIG_NAME "ahbot.conf"

#define MANGOSD_CONFIG_LOCATION         SYSCONFDIR MANGOSD_CONFIG_NAME
#define REALMD_CONFIG_LOCATION          SYSCONFDIR REALMD_CONFIG_NAME
#define AUCTIONHOUSEBOT_CONFIG_LOCATION SYSCONFDIR AUCTIONHOUSEBOT_CONFIG_NAME

// --- Defaults for settings an operator did not set ---------------------------

#define DEFAULT_PLAYER_LIMIT            100
#define DEFAULT_WORLDSERVER_PORT        8085
#define DEFAULT_WORLDSERVER_STREAM_PORT 8086
#define DEFAULT_REALMSERVER_PORT        3724

// --- Host ---------------------------------------------------------------------

// Depends on Platform/Define.h, which the resource compiler does not read.
#ifndef RC_INVOKED
# if MANGOS_ENDIAN == MANGOS_BIGENDIAN
#  define MANGOS_ENDIAN_STRING "big-endian"
# else
#  define MANGOS_ENDIAN_STRING "little-endian"
# endif
#endif

// --- Windows resource version -------------------------------------------------
//
// VersionInfo.rc reads these. They are the project version as four integers,
// which is the only shape a VERSIONINFO resource accepts.

#define PRODUCT_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define PRODUCT_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define PRODUCT_VERSION_PATCH @PROJECT_VERSION_PATCH@

#define FILE_VERSION_MAJOR PRODUCT_VERSION_MAJOR
#define FILE_VERSION_MINOR PRODUCT_VERSION_MINOR
#define FILE_VERSION_PATCH PRODUCT_VERSION_PATCH

#define __TO_STRING_IMPL(x) #x
#define __TO_STRING(x)      __TO_STRING_IMPL(x)

#define PRODUCT_VERSION_MAJOR_MINOR_STR \
    __TO_STRING(PRODUCT_VERSION_MAJOR) "." __TO_STRING(PRODUCT_VERSION_MINOR)
#define PRODUCT_VERSION_MAJOR_MINOR_PATCH_STR \
    PRODUCT_VERSION_MAJOR_MINOR_STR "." __TO_STRING(PRODUCT_VERSION_PATCH)
#define PRODUCT_VERSION_FULL_STR     PRODUCT_VERSION_MAJOR_MINOR_PATCH_STR
#define PRODUCT_VERSION_RESOURCE     PRODUCT_VERSION_MAJOR,PRODUCT_VERSION_MINOR,PRODUCT_VERSION_PATCH
#define PRODUCT_VERSION_RESOURCE_STR PRODUCT_VERSION_FULL_STR "\0"

#define FILE_VERSION_MAJOR_MINOR_STR \
    __TO_STRING(FILE_VERSION_MAJOR) "." __TO_STRING(FILE_VERSION_MINOR)
#define FILE_VERSION_MAJOR_MINOR_PATCH_STR \
    FILE_VERSION_MAJOR_MINOR_STR "." __TO_STRING(FILE_VERSION_PATCH)
#define FILE_VERSION_FULL_STR     FILE_VERSION_MAJOR_MINOR_PATCH_STR
#define FILE_VERSION_RESOURCE     FILE_VERSION_MAJOR,FILE_VERSION_MINOR,FILE_VERSION_PATCH
#define FILE_VERSION_RESOURCE_STR FILE_VERSION_FULL_STR "\0"

#define VER_COMPANY_NAME_STR   "MaNGOS Developers"
#define VER_LEGALCOPYRIGHT_STR "(c)2005-@rev_year@ MaNGOS"
#define VER_FILEVERSION        0,0,0
#define VER_FILEVERSION_STR    "@rev_hash@ @rev_date@ (@rev_branch@ branch)"
#define VER_PRODUCTVERSION     VER_FILEVERSION
#define VER_PRODUCTVERSION_STR VER_FILEVERSION_STR
